{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval-case.json",
  "title": "Proposed Quality Lab case",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "proposed"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "department": {
      "enum": [
        "design",
        "engineering",
        "strategy"
      ]
    },
    "job": {
      "type": "string",
      "minLength": 1
    },
    "brief": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "required_output_format": {
      "type": "string",
      "minLength": 1
    },
    "rubric": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "anchors": {
            "type": "object",
            "properties": {
              "1": {
                "type": "string",
                "minLength": 1
              },
              "2": {
                "type": "string",
                "minLength": 1
              },
              "3": {
                "type": "string",
                "minLength": 1
              },
              "4": {
                "type": "string",
                "minLength": 1
              },
              "5": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "1",
              "2",
              "3",
              "4",
              "5"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "criterion",
          "weight",
          "anchors"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "pass_bar": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "disqualifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "judge_instructions": {
      "type": "string",
      "minLength": 1
    },
    "class": {
      "enum": [
        "evidence",
        "demo"
      ]
    }
  },
  "required": [
    "schema_version",
    "status",
    "id",
    "department",
    "job",
    "brief",
    "inputs",
    "required_output_format",
    "rubric",
    "pass_bar",
    "disqualifiers",
    "judge_instructions",
    "class"
  ],
  "additionalProperties": false
}
